---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData } from '~/navigation';
import { DEFAULT_LOCALE, LOCALES, getLocaleFromUrl, localePath, useTranslations, type Locale } from '~/i18n';
import { getLocalizedEntries, entryKey } from '~/utils/localizedContent';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  locales?: Locale[];
}

const { metadata, locales = [...LOCALES] } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => localePath(path, locale);

const games = await getLocalizedEntries('games', locale);
const apps = await getLocalizedEntries('apps', locale);

const headerLinks = [
  { text: t('nav.home'), href: lp('/') },
  {
    text: t('nav.games'),
    href: lp('/games'),
    links: games.map((game) => ({ text: game.data.title, href: lp(`/games/${entryKey(game)}`) })),
  },
  {
    text: t('nav.apps'),
    href: lp('/apps'),
    links: apps.map((app) => ({ text: app.data.title, href: lp(`/apps/${entryKey(app)}`) })),
  },
  // The blog is Korean-only for now, so it stays out of the English nav
  // rather than dropping English readers into Korean posts.
  ...(locale === DEFAULT_LOCALE ? [{ text: t('nav.blog'), href: lp('/posts') }] : []),
  { text: t('nav.about'), href: lp('/about') },
  { text: t('nav.contact'), href: lp('/contact') },
];

const footerLinks = [
  {
    title: t('nav.games'),
    href: lp('/games'),
    links: games.map((game) => ({ text: game.data.title, href: lp(`/games/${entryKey(game)}`) })),
  },
  {
    title: t('nav.apps'),
    href: lp('/apps'),
    links: apps.map((app) => ({ text: app.data.title, href: lp(`/apps/${entryKey(app)}`) })),
  },
  ...(locale === DEFAULT_LOCALE ? [{ title: t('nav.blog'), href: lp('/posts'), links: [] }] : []),
  {
    title: 'SolePrize Studio',
    links: [
      { text: t('nav.about'), href: lp('/about') },
      { text: t('nav.contact'), href: lp('/contact') },
    ],
  },
];

// The legal pages exist only in Korean and are written under Korean law, so
// they are deliberately NOT locale-prefixed - /en/terms was a dead link.
// Label them in the reader's language, but send everyone to the one authoritative copy.
const footerSecondaryLinks = [
  { text: t('nav.terms'), href: localePath('/terms', DEFAULT_LOCALE) },
  { text: t('nav.privacy'), href: localePath('/privacy', DEFAULT_LOCALE) },
];
---

<Layout metadata={metadata} locales={locales}>
  <slot name="header">
    <Header {...headerData} links={headerLinks} isSticky showToggleTheme showLanguageSwitcher />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} links={footerLinks} secondaryLinks={footerSecondaryLinks} />
  </slot>
</Layout>
