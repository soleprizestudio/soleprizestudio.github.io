---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import { DEFAULT_LOCALE, LOCALE_TAGS, LOCALES, getLocaleFromUrl, localePath, stripLocale, type Locale } from '~/i18n';
import { getCanonical } from '~/utils/permalinks';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  /** Locales this page actually exists in - drives hreflang. Korean-only pages (blog) pass ['ko']. */
  locales?: Locale[];
}

const { metadata = {}, locales = [...LOCALES] } = Astro.props;
const { textDirection } = I18N;

const locale = getLocaleFromUrl(Astro.url);
const basePath = stripLocale(Astro.url.pathname);

// Only worth pairing when the page genuinely exists in more than one language;
// a lone hreflang pointing at itself is noise.
const alternates = locales.length > 1 ? locales : [];
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[alt]} href={getCanonical(localePath(basePath, alt))} />
      ))
    }
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={getCanonical(localePath(basePath, DEFAULT_LOCALE))} />
      )
    }

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>
