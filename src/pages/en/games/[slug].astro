---
import GameDetailPage from '~/components/pages/GameDetailPage.astro';
import { getLocalizedStaticPaths, getAvailableLocales } from '~/utils/localizedContent';

export async function getStaticPaths() {
  return await getLocalizedStaticPaths('games', 'en');
}

const { entry } = Astro.props;
const availableLocales = await getAvailableLocales('games', Astro.params.slug!);
---

<GameDetailPage entry={entry} availableLocales={availableLocales} />
