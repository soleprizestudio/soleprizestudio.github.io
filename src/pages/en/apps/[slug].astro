---
import AppDetailPage from '~/components/pages/AppDetailPage.astro';
import { getLocalizedStaticPaths, getAvailableLocales } from '~/utils/localizedContent';

export async function getStaticPaths() {
  return await getLocalizedStaticPaths('apps', 'en');
}

const { entry } = Astro.props;
const availableLocales = await getAvailableLocales('apps', Astro.params.slug!);
---

<AppDetailPage entry={entry} availableLocales={availableLocales} />
