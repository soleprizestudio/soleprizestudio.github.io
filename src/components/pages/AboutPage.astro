---
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getLocaleFromUrl, localePath, useTranslations } from '~/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const contactHref = localePath('/contact', locale);

const metadata = { title: t('about.title'), description: t('about.subtitle') };

const items =
  locale === 'en'
    ? [
        {
          title: 'Who I am',
          description:
            'Hello — I go by 평발 (Pyeongbal), a shortening of "평범한 개발자", meaning "an ordinary developer". I have a day job; apps and games are what I make on weekends, as a hobby.',
        },
        {
          title: 'Why SolePrize',
          description:
            'Sole (발, "foot") and Prize (상, "award") put together read 발상 in Korean — "a bright idea". The hope is to make ideas worth a prize. Said out loud it also sounds a little like "surprise", so it carries that meaning too: a place for surprising ideas.',
        },
        {
          title: 'What I make',
          description:
            'There are plenty of good services already. I look for the small inconveniences they leave behind. Lottery apps are everywhere, so Lotto 1pan drops number picking and does one thing: finds the nearest store that sold a first-prize ticket. And when you sit down to a board game and the dice are missing, installing an app is already too late — so Board Game Dice is a web page.',
        },
        {
          title: 'What I stick to',
          description:
            "Personal data stays on your device wherever possible, and I lean on servers as little as I can. I try to avoid subscriptions. Ads go in only as far as it takes to keep building, and never at the moment that matters — that's why Lotto 1pan shows first-prize stores with no ad in the way.",
        },
        {
          title: 'Get in touch',
          description: `If you have a question, or something you wish someone would build, reach out through the <a href="${contactHref}" class="text-primary font-medium hover:underline">contact page</a>.`,
        },
      ]
    : [
        {
          title: '누구인가요',
          description:
            "안녕하세요, '평범한 개발자'를 줄여 평발이라는 닉네임을 씁니다. 본업이 따로 있고 앱과 게임은 주말에 취미로 만듭니다.",
        },
        {
          title: '왜 SolePrize인가요',
          description:
            'Sole(발)과 Prize(상)를 이으면 발상이 됩니다. 상 받을 만한 발상으로 만들자는 뜻입니다. 소리 내어 읽으면 Surprise와 비슷하게 들려서 놀라운 발상을 만드는 곳이라는 뜻도 담았습니다.',
        },
        {
          title: '무엇을 만드나요',
          description:
            '이미 좋은 서비스는 많습니다. 그 서비스들이 놓치고 있는 작은 불편함을 찾아서 만듭니다. 로또 앱은 이미 많아서 번호 뽑는 기능은 빼고 가까운 1등 판매점을 찾는 기능 하나만 넣어 로또 1판을 만들었습니다. 보드게임을 하려는데 주사위가 없을 때 앱을 받고 있으면 이미 늦어서 보드게임 주사위는 웹으로 만들었습니다.',
        },
        {
          title: '지키는 것들',
          description:
            '개인정보는 되도록 쓰는 분의 기기 안에 두고 서버에 기대는 부분은 줄입니다. 구독은 되도록 피합니다. 광고는 계속 만들 수 있을 만큼만 넣고 중요한 순간에는 띄우지 않습니다. 로또 1판에서 1등 판매점을 광고 없이 보여주는 것도 그래서입니다.',
        },
        {
          title: '문의',
          description: `궁금한 점이나 만들어줬으면 하는 게 있다면 <a href="${contactHref}" class="text-primary font-medium hover:underline">문의 페이지</a>로 편하게 연락 주세요.`,
        },
      ];
---

<Layout metadata={metadata}>
  <Hero tagline="About">
    <Fragment slot="title">{t('about.title')}</Fragment>
    <Fragment slot="subtitle">{t('about.subtitle')}</Fragment>
  </Hero>

  <Content title="SolePrize Studio" isAfterContent={true} items={items} />
</Layout>
