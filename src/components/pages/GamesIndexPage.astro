---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n';
import { getLocalizedEntries, entryPath } from '~/utils/localizedContent';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const games = await getLocalizedEntries('games', locale);

const metadata = { title: t('games.title'), description: t('games.subtitle') };
---

<Layout metadata={metadata}>
  <HeroText tagline="Games" title={t('games.title')} subtitle={t('games.subtitle')} />

  {games.length === 0 && <p class="text-muted text-center pb-16">{t('games.empty')}</p>}

  <Features
    columns={Math.min(2, Math.max(games.length, 1))}
    classes={{ container: 'pt-0 md:pt-0 lg:pt-0' }}
    items={games.map((game) => ({
      title: game.data.title,
      description: game.data.teaser,
      icon: 'tabler:device-gamepad-2',
      image: game.data.thumbnail
        ? { src: game.data.thumbnail, alt: `${game.data.title} ${t('games.thumbnailAlt')}` }
        : undefined,
      callToAction: {
        text: t('games.viewDetail'),
        href: entryPath('games', game),
      },
    }))}
  />
</Layout>
