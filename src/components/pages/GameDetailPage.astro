---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import Giscus from '~/components/blog/Giscus.astro';
import { getLocaleFromUrl, useTranslations, type Locale } from '~/i18n';

export interface Props {
  entry: CollectionEntry<'games'>;
  /** Locales this game has a real translation for - drives hreflang. */
  availableLocales: Locale[];
}

const { entry, availableLocales } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const { Content, headings } = await render(entry);

const metadata = { title: entry.data.title, description: entry.data.teaser };
---

<Layout metadata={metadata} locales={availableLocales}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 lg:max-w-6xl">
    <div class="lg:flex lg:gap-10 lg:max-w-none max-w-4xl mx-auto">
      <article class="lg:max-w-4xl lg:min-w-0 lg:flex-1">
        <h1 class="font-bold font-heading text-2xl md:text-3xl leading-tighter tracking-tighter mb-6">
          {entry.data.title}
        </h1>

        <div class="aspect-video w-full border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden">
          <iframe
            src={entry.data.playPath}
            class="w-full h-full"
            title={entry.data.title}
            loading="lazy"
            allow="accelerometer; gyroscope; fullscreen"></iframe>
        </div>
        <div class="mb-8 mt-2 text-right">
          <a
            href={entry.data.playPath}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary text-sm hover:underline"
          >
            <Icon name="tabler:external-link" class="w-4 h-4 inline-block -mt-0.5" />
            {t('games.openInNewTab')}
          </a>
        </div>

        {
          entry.data.showToc && (
            <div class="lg:hidden mb-8">
              <TableOfContents headings={headings} variant="mobile" showCommentsAction={entry.data.showComments} />
            </div>
          )
        }

        <div class="prose dark:prose-invert max-w-none prose-headings:scroll-mt-[105px] prose-a:text-primary">
          <Content />
        </div>

        {
          entry.data.showComments && (
            <div id="comments" class="mt-10 scroll-mt-[105px]">
              <Giscus />
            </div>
          )
        }
      </article>
      {
        entry.data.showToc && (
          <TableOfContents
            headings={headings}
            variant="desktop"
            showCommentsAction={entry.data.showComments}
            class="hidden lg:block lg:w-56 lg:shrink-0"
          />
        )
      }
    </div>
  </section>
</Layout>
