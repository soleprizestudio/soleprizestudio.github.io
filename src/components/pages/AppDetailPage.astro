---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import Giscus from '~/components/blog/Giscus.astro';
import { getLocaleFromUrl, useTranslations, type Locale } from '~/i18n';

export interface Props {
  entry: CollectionEntry<'apps'>;
  /** Locales this app has a real translation for - drives hreflang. */
  availableLocales: Locale[];
}

const { entry, availableLocales } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const { Content, headings } = await render(entry);

const ogKey = entry.data.translationKey || entry.id;
const metadata = {
  title: entry.data.title,
  description: entry.data.description,
  // generateOgCards (astro.config.ts) composes this card for every entry with an icon
  ...(entry.data.iconImage
    ? { openGraph: { images: [{ url: `/og/apps-${ogKey}.jpg`, width: 1200, height: 630 }] } }
    : {}),
};
---

<Layout metadata={metadata} locales={availableLocales}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 lg:max-w-6xl">
    <div class="lg:flex lg:gap-10 lg:max-w-none max-w-4xl mx-auto">
      <article class="lg:max-w-4xl lg:min-w-0 lg:flex-1">
        <div class="flex items-center gap-4 mb-6">
          {
            entry.data.iconImage ? (
              <Image
                src={entry.data.iconImage}
                alt={`${entry.data.title} ${t('apps.iconAlt')}`}
                width={96}
                height={96}
                densities={[1, 2, 3]}
                layout="fixed"
                class="rounded-[22%] shadow-md"
              />
            ) : (
              <Icon name={entry.data.icon || 'tabler:apps'} class="w-12 h-12 text-primary" />
            )
          }
          <h1 class="font-bold font-heading text-2xl md:text-3xl leading-tighter tracking-tighter">
            {entry.data.title}
          </h1>
        </div>

        <p class="text-muted text-xl mb-8">{entry.data.description}</p>

        {
          entry.data.showToc && (
            <div class="lg:hidden mb-8">
              <TableOfContents headings={headings} variant="mobile" showCommentsAction={entry.data.showComments} />
            </div>
          )
        }

        <div class="prose dark:prose-invert max-w-none prose-headings:scroll-mt-[105px] prose-a:text-primary">
          <Content />
        </div>

        {
          entry.data.storeUrl && (
            <div class="mt-10 flex items-center gap-4 flex-wrap">
              <a
                href={entry.data.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t('apps.downloadAria')}
              >
                <Image
                  src="~/assets/images/app-store-badge-black.svg"
                  alt="Download on the App Store"
                  width={144}
                  height={48}
                  layout="fixed"
                  class="dark:hidden"
                />
                <Image
                  src="~/assets/images/app-store-badge-white.svg"
                  alt="Download on the App Store"
                  width={144}
                  height={48}
                  layout="fixed"
                  class="hidden dark:block"
                />
              </a>
              {entry.data.privacyUrl && (
                <a href={entry.data.privacyUrl} class="text-muted hover:text-primary hover:underline text-sm">
                  {t('apps.privacy')}
                </a>
              )}
            </div>
          )
        }

        {
          entry.data.showComments && (
            <div id="comments" class="mt-10 scroll-mt-[105px]">
              <Giscus />
            </div>
          )
        }
      </article>
      {
        entry.data.showToc && (
          <TableOfContents
            headings={headings}
            variant="desktop"
            showCommentsAction={entry.data.showComments}
            class="hidden lg:block lg:w-56 lg:shrink-0"
          />
        )
      }
    </div>
  </section>
</Layout>
