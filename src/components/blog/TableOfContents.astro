---
import { Icon } from 'astro-icon/components';
import type { MarkdownHeading } from 'astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n';

export interface Props {
  headings?: MarkdownHeading[];
  class?: string;
  variant?: 'mobile' | 'desktop';
  showCommentsAction?: boolean;
}

const { headings = [], class: className = '', variant = 'desktop', showCommentsAction = true } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const actions = [
  { action: 'top', icon: 'tabler:arrow-up', text: t('toc.top') },
  ...(showCommentsAction ? [{ action: 'comments', icon: 'tabler:message-circle', text: t('toc.comments') }] : []),
  { action: 'copy', icon: 'tabler:link', text: t('toc.copy') },
] as const;

// The copy button swaps its own label on click. That runs client-side, where
// the dictionary isn't available, so both strings ride along on the element.
const copyLabels = { idle: t('toc.copy'), done: t('toc.copied') };
---

{
  (
    <div
      class:list={[
        'not-prose text-sm',
        className,
        variant === 'desktop' && 'sticky top-[105px] max-h-[calc(100vh-105px)] overflow-y-auto flex items-center',
      ]}
    >
      {variant === 'mobile' ? (
        <details class="rounded-lg border border-gray-200 dark:border-slate-700 px-4 py-3">
          <summary class="cursor-pointer font-medium">{t('toc.title')}</summary>
          <nav class="mt-3">
            {items.length > 0 ? (
              <ul class="space-y-2">
                {items.map((h) => (
                  <li class:list={[h.depth === 3 && 'ml-4']}>
                    <a href={`#${h.slug}`} class="text-muted hover:text-primary hover:underline">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-muted">{t('toc.empty')}</p>
            )}
          </nav>
          <div class="mt-4 flex flex-col gap-2 border-t dark:border-slate-700 pt-3">
            {actions.map(({ action, icon, text }) => (
              <button
                type="button"
                data-toc-action={action}
                class="flex items-center gap-2 text-muted hover:text-primary text-left"
              >
                <Icon name={icon} class="w-4 h-4" />
                <span
                  data-toc-label={action === 'copy' ? '' : undefined}
                  data-toc-copy-idle={action === 'copy' ? copyLabels.idle : undefined}
                  data-toc-copy-done={action === 'copy' ? copyLabels.done : undefined}
                >
                  {text}
                </span>
              </button>
            ))}
          </div>
        </details>
      ) : (
        <div class="w-full py-6">
          {items.length > 0 && (
            <>
              <p class="font-medium mb-3">{t('toc.title')}</p>
              <nav>
                <ul class="space-y-2 border-l dark:border-slate-700">
                  {items.map((h) => (
                    <li class:list={[h.depth === 3 && 'ml-4']}>
                      <a
                        href={`#${h.slug}`}
                        class="block border-l-2 border-transparent -ml-px pl-3 text-muted hover:text-primary hover:border-primary"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </>
          )}
          <div class:list={['flex flex-col gap-3', { 'mt-6 border-t dark:border-slate-700 pt-4': items.length > 0 }]}>
            {actions.map(({ action, icon, text }) => (
              <button
                type="button"
                data-toc-action={action}
                class="flex items-center gap-2 text-muted hover:text-primary text-left"
              >
                <Icon name={icon} class="w-4 h-4" />
                <span
                  data-toc-label={action === 'copy' ? '' : undefined}
                  data-toc-copy-idle={action === 'copy' ? copyLabels.idle : undefined}
                  data-toc-copy-done={action === 'copy' ? copyLabels.done : undefined}
                >
                  {text}
                </span>
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  )
}

<script>
  const boundButtons = new WeakSet<Element>();

  function initTocActions() {
    document.querySelectorAll<HTMLButtonElement>('[data-toc-action]').forEach((button) => {
      if (boundButtons.has(button)) return;
      boundButtons.add(button);

      button.addEventListener('click', () => {
        const action = button.dataset.tocAction;

        if (action === 'top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else if (action === 'comments') {
          document.getElementById('comments')?.scrollIntoView({ behavior: 'smooth' });
        } else if (action === 'copy') {
          navigator.clipboard
            .writeText(window.location.href)
            .then(() => {
              const label = button.querySelector<HTMLElement>('[data-toc-label]');
              if (!label) return;
              const idle = label.dataset.tocCopyIdle ?? label.textContent ?? '';
              label.textContent = label.dataset.tocCopyDone ?? idle;
              setTimeout(() => {
                label.textContent = idle;
              }, 1500);
            })
            .catch(() => {});
        }
      });
    });
  }

  initTocActions();
  document.addEventListener('astro:page-load', initTocActions);
</script>
