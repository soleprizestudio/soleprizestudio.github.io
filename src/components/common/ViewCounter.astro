---
import { Icon } from 'astro-icon/components';

export interface Props {
  /** Absolute path of the post whose count to show. Defaults to the current page's path. */
  path?: string;
  /** When true, only reads the count without incrementing it (for list views). */
  readOnly?: boolean;
}

const { path, readOnly = false } = Astro.props;
---

<span
  class="view-counter inline-flex items-center shrink-0 whitespace-nowrap"
  data-view-path={path ?? ''}
  data-view-readonly={readOnly}
>
  <Icon name="tabler:eye" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
  <span class="view-count ml-1">-</span>
</span>

<script>
  const WORKER_URL = 'https://home-page-cms.soleprizestudio.workers.dev';
  const initialized = new WeakSet<Element>();

  function normalizePath(path: string): string {
    return path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
  }

  async function loadViews(el: HTMLElement) {
    const countEl = el.querySelector<HTMLElement>('.view-count');
    if (!countEl) return;
    const path = normalizePath(el.dataset.viewPath || window.location.pathname);
    const readOnly = el.dataset.viewReadonly === 'true';
    try {
      const res = await fetch(`${WORKER_URL}/views${path}${readOnly ? '?read=1' : ''}`);
      if (!res.ok) throw new Error('view fetch failed');
      const data = await res.json();
      countEl.textContent = data.views.toLocaleString();
    } catch {
      countEl.textContent = '-';
    }
  }

  function initViewCounters() {
    document.querySelectorAll<HTMLElement>('.view-counter').forEach((el) => {
      if (initialized.has(el)) return;
      initialized.add(el);
      loadViews(el);
    });
  }

  initViewCounters();
  document.addEventListener('astro:page-load', initViewCounters);
</script>
